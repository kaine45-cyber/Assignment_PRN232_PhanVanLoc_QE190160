# Copy to .env (or set these on Render → Environment). Never commit real secrets.

# PostgreSQL connection (Render gives a URI like this; it is converted automatically)
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE

# Production on Render, Development locally
ASPNETCORE_ENVIRONMENT=Production

# Frontend origins allowed by CORS (comma separated)
CORS_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app

# Frontend-only variable (listed for completeness; set it in the FE project / Vercel)
NEXT_PUBLIC_API_URL=https://your-backend.onrender.com
